<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Proposal - {{project_name}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    :root {
      --primary: #1e2d40;
      --accent: #3b6ea5;
      --accent-light: #eaf0f8;
      --text: #2d3748;
      --muted: #718096;
      --border: #d1dbe8;
      --bg: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 10.5pt;
      line-height: 1.75;
      color: var(--text);
      counter-reset: section-counter;
    }

    /* ── WATERMARK ── */
    .watermark {
      position: fixed;
      top: 48%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-38deg);
      font-size: 68pt;
      font-weight: 900;
      color: rgba(30, 45, 64, 0.04);
      white-space: nowrap;
      pointer-events: none;
      z-index: 0;
      letter-spacing: 3px;
      user-select: none;
    }

    /* ── PAGE BREAKS ── */
    .page-break {
      page-break-before: always;
      break-before: page;
    }

    .no-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    /* ── COVER PAGE ── */
    .cover-page {
      height: 100vh;
      background: var(--primary);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 60px 70px;
      position: relative;
      overflow: hidden;
    }

    .cover-page::after {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 8px;
      background: var(--accent);
    }

    .cover-logo-row {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .cover-logo-img {
      width: 60px;
      height: auto;
      background: rgba(255, 255, 255, 0.92);
      padding: 8px;
      border-radius: 8px;
    }

    .cover-logo-name {
      font-size: 15pt;
      font-weight: 700;
      letter-spacing: 1px;
      color: white;
    }

    .cover-tagline {
      font-size: 8.5pt;
      color: rgba(255, 255, 255, 0.5);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .cover-title {
      font-size: 42pt;
      font-weight: 800;
      line-height: 1.1;
      border-left: 7px solid var(--accent);
      padding-left: 20px;
      margin-bottom: 12px;
    }

    .cover-subtitle {
      font-size: 15pt;
      font-weight: 300;
      opacity: 0.85;
      padding-left: 28px;
    }

    .cover-meta {
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: 24px;
    }

    .cover-meta table {
      border: none;
      margin: 0;
      width: auto;
    }

    .cover-meta td {
      border: none;
      padding: 5px 50px 5px 0;
      color: rgba(255, 255, 255, 0.85);
      font-size: 10.5pt;
    }

    .cover-meta td:first-child {
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      text-transform: uppercase;
      font-size: 8.5pt;
      letter-spacing: 0.8px;
    }

    /* ── BODY WRAPPER ── */
    .body-content {
      padding: 0 52px;
      position: relative;
      z-index: 1;
    }

    /* ── ABOUT COMPANY PAGE ── */
    .about-page {
      min-height: 60vh;
      padding: 40px 0 20px;
    }

    .about-header {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 18px;
      border-bottom: 2px solid var(--border);
    }

    .about-logo-sm {
      width: 50px;
      height: auto;
      background: var(--accent-light);
      padding: 6px;
      border-radius: 6px;
    }

    .about-company-name {
      font-size: 16pt;
      font-weight: 800;
      color: var(--primary);
    }

    .about-tagline-sm {
      font-size: 9pt;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .about-body p {
      margin-bottom: 12px;
      text-align: justify;
    }

    .about-stats {
      display: flex;
      gap: 0;
      margin-top: 28px;
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
    }

    .stat {
      flex: 1;
      text-align: center;
      padding: 18px 10px;
      border-right: 1px solid var(--border);
    }

    .stat:last-child {
      border-right: none;
    }

    .stat-number {
      font-size: 22pt;
      font-weight: 800;
      color: var(--accent);
    }

    .stat-label {
      font-size: 8.5pt;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-top: 2px;
    }

    /* ── SECTION ── */
    .section {
      padding: 32px 0 24px;
      border-bottom: 1px solid var(--border);
    }

    .section:last-of-type {
      border-bottom: none;
    }

    .section-title {
      font-size: 18pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 8px;
      display: flex;
      align-items: baseline;
      gap: 10px;
      counter-increment: section-counter;
    }

    .section-title::before {
      content: counter(section-counter) ".";
      font-size: 13pt;
      font-weight: 400;
      color: var(--accent);
      min-width: 26px;
    }

    .section-rule {
      height: 2px;
      background: var(--border);
      margin-bottom: 20px;
      border: none;
    }

    /* ── CONTENT TYPOGRAPHY ── */
    .content p {
      margin: 0 0 10px;
      text-align: justify;
    }

    .content strong {
      color: var(--primary);
    }

    .content em {
      color: var(--accent);
    }

    /* Feature numbered headings */
    .content .feat-heading {
      font-size: 11pt;
      font-weight: 700;
      color: var(--primary);
      background: var(--accent-light);
      border-left: 4px solid var(--accent);
      padding: 7px 12px;
      margin: 18px 0 8px;
      border-radius: 0 4px 4px 0;
    }

    /* Bullet lists under features */
    .content .feat-list {
      margin: 4px 0 10px 22px;
      padding: 0;
    }

    .content .feat-list li {
      margin-bottom: 4px;
      line-height: 1.6;
      list-style-type: disc;
    }

    .content .feat-list li::marker {
      color: var(--accent);
    }

    /* Generic ul/ol */
    .content ul,
    .content ol {
      margin: 6px 0 12px 22px;
      padding: 0;
    }

    .content ul li,
    .content ol li {
      margin-bottom: 5px;
      line-height: 1.6;
    }

    .content ul li::marker {
      color: var(--accent);
    }

    /* Key-Value rows (tech stack etc.) */
    .content .kv-row {
      display: flex;
      gap: 8px;
      padding: 6px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 10.5pt;
    }

    .content .kv-key {
      font-weight: 600;
      color: var(--primary);
      min-width: 130px;
    }

    /* Section headings within content */
    .content h1 {
      font-size: 13pt;
      font-weight: 700;
      color: var(--primary);
      margin: 18px 0 8px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 4px;
    }

    .content h2 {
      font-size: 11.5pt;
      font-weight: 600;
      color: var(--primary);
      margin: 14px 0 7px;
    }

    .content h3 {
      font-size: 10.5pt;
      font-weight: 600;
      color: var(--accent);
      margin: 10px 0 5px;
    }

    /* ── COST TABLE ── */
    .cost-table {
      width: 100%;
      border-collapse: collapse;
      margin: 8px 0 0;
      font-size: 10pt;
    }

    .cost-table th {
      background: var(--primary);
      color: white;
      padding: 10px 14px;
      text-align: left;
      font-size: 8.5pt;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      font-weight: 600;
    }

    .cost-table td {
      border: 1px solid var(--border);
      padding: 9px 14px;
    }

    .cost-table tr:nth-child(even) {
      background: #f7fafc;
    }

    .cost-table .right {
      text-align: right;
    }

    .cost-total-row td {
      background: var(--accent-light) !important;
      font-weight: 700;
      font-size: 11pt;
      color: var(--primary);
      border-top: 2px solid var(--accent);
    }

    /* ── SIGN-OFF ── */
    .signoff-table {
      width: 100%;
      border: none;
      margin-top: 60px;
    }

    .signoff-table td {
      border: none;
      vertical-align: top;
      width: 50%;
      padding: 0 40px 0 0;
    }

    .signoff-line {
      border-top: 1px solid #aaa;
      margin-top: 70px;
    }

    .signoff-label {
      font-size: 9pt;
      color: var(--muted);
      margin-top: 6px;
    }
  </style>
</head>

<body>

  <!-- WATERMARK (fixed, shows on every page) -->
  <div class="watermark">ArgosMob Tech &amp; AI</div>

  <!-- ░░ COVER PAGE ░░ -->
  <div class="cover-page">
    <div class="cover-logo-row">
      <img class="cover-logo-img"
        src="data:image/svg+xml;base64,"
        alt="ArgosMob Logo" />
      <div>
        <div class="cover-logo-name">ArgosMob</div>
        <div class="cover-tagline">Tech &amp; AI</div>
      </div>
    </div>

    <div>
      <div class="cover-title">Formal<br />Proposal</div>
      <div class="cover-subtitle">Prepared for {{client_name}}</div>
    </div>

    <div class="cover-meta">
      <table>
        <tr>
          <td>Project</td>
          <td>{{project_name}}</td>
        </tr>
        <tr>
          <td>Date</td>
          <td>{{current_date}}</td>
        </tr>
        <tr>
          <td>Prepared By</td>
          <td>ArgosMob Tech &amp; AI</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ░░ PAGE 2 — ABOUT ARGOSMOB ░░ -->
  <div class="body-content page-break">
    <div class="about-page">
      <div class="about-header">
        <img class="about-logo-sm"
          src="data:image/svg+xml;base64,"
          alt="ArgosMob Logo" />
        <div>
          <div class="about-company-name">ArgosMob Tech &amp; AI</div>
          <div class="about-tagline-sm">Your Partner in Digital Transformation</div>
        </div>
      </div>

      {{#if aboutCompany}}
      <div class="about-body content">{{{aboutCompany}}}</div>
      {{else}}
      <div class="about-body content">
        <p>ArgosMob Tech &amp; AI is a premier technology company specialising in building innovative mobile
          applications, web platforms, and AI-powered digital products. Founded with the vision of making world-class
          technology accessible, we bring together multi-disciplinary engineering talent to deliver solutions that are
          scalable, reliable, and beautifully designed.</p>
        <p>We partner with startups and enterprises alike to rapidly ideate, design, and ship products that make a real
          difference. Our cross-functional teams bring expertise across mobile (iOS &amp; Android), backend engineering,
          cloud infrastructure, UI/UX design, and artificial intelligence.</p>
        <p>Every project at ArgosMob is driven by a simple belief: technology should solve real problems, fast.</p>
      </div>
      {{/if}}

      <div class="about-stats">
        <div class="stat">
          <div class="stat-number">50+</div>
          <div class="stat-label">Projects Delivered</div>
        </div>
        <div class="stat">
          <div class="stat-number">30+</div>
          <div class="stat-label">Happy Clients</div>
        </div>
        <div class="stat">
          <div class="stat-number">5+</div>
          <div class="stat-label">Years Experience</div>
        </div>
        <div class="stat">
          <div class="stat-number">15+</div>
          <div class="stat-label">Team Strength</div>
        </div>
      </div>
    </div>

    <!-- ░░ PROPOSAL BODY SECTIONS ░░ -->
    {{#if intro}}
    <div class="section no-break">
      <h2 class="section-title">Introduction</h2>
      <hr class="section-rule" />
      <div class="content">{{{intro}}}</div>
    </div>
    {{/if}}

    {{#each sections}}
    {{#if enabled}}
    <div class="section no-break">
      <h2 class="section-title">{{name}}</h2>
      <hr class="section-rule" />
      <div class="content">{{{content}}}</div>
    </div>
    {{/if}}
    {{/each}}

    {{#if features}}
    <div class="section">
      <h2 class="section-title">Features &amp; Functionalities</h2>
      <hr class="section-rule" />
      <div class="content">{{{features}}}</div>
    </div>
    {{/if}}

    {{#if techStack}}
    <div class="section no-break">
      <h2 class="section-title">Tech Stack</h2>
      <hr class="section-rule" />
      <div class="content">{{{techStack}}}</div>
    </div>
    {{/if}}

    {{#if deliverables}}
    <div class="section no-break">
      <h2 class="section-title">Deliverables</h2>
      <hr class="section-rule" />
      <div class="content">{{{deliverables}}}</div>
    </div>
    {{/if}}

    {{#if timeline}}
    <div class="section no-break">
      <h2 class="section-title">Timeline</h2>
      <hr class="section-rule" />
      <div class="content">{{{timeline}}}</div>
    </div>
    {{/if}}

    {{#if cost_table.length}}
    <div class="section page-break">
      <h2 class="section-title">Cost Estimation</h2>
      <hr class="section-rule" />
      <table class="cost-table">
        <thead>
          <tr>
            <th>Description</th>
            <th class="right" width="8%">Qty</th>
            <th class="right" width="18%">Unit Price</th>
            <th class="right" width="18%">Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each cost_table}}
          <tr>
            <td>{{description}}</td>
            <td class="right">{{quantity}}</td>
            <td class="right">₹{{unitPrice}}</td>
            <td class="right">₹{{total}}</td>
          </tr>
          {{/each}}
          <tr class="cost-total-row">
            <td colspan="3" class="right">Grand Total</td>
            <td class="right">₹{{grand_total}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if changeRequest}}
    <div class="section no-break">
      <h2 class="section-title">Change Request Management</h2>
      <hr class="section-rule" />
      <div class="content">{{{changeRequest}}}</div>
    </div>
    {{/if}}

    <!-- Sign-Off -->
    <div class="section page-break">
      <h2 class="section-title">Acceptance &amp; Sign-Off</h2>
      <hr class="section-rule" />
      <div class="content">
        <p>By signing below, both parties agree to the scope, deliverables, timelines, and costs outlined in this
          proposal.</p>
        <table class="signoff-table">
          <tr>
            <td>
              <strong>For {{client_name}}</strong>
              <div class="signoff-line"></div>
              <div class="signoff-label">Authorised Signatory &nbsp;|&nbsp; Date: ___________</div>
            </td>
            <td>
              <strong>For ArgosMob Tech &amp; AI</strong>
              <div class="signoff-line"></div>
              <div class="signoff-label">Authorised Signatory &nbsp;|&nbsp; Date: ___________</div>
            </td>
          </tr>
        </table>
      </div>
    </div>

  </div><!-- /body-content -->
</body>

</html>