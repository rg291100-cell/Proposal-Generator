<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Proposal - {{project_name}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    :root {
      --primary: #1e2d40;
      --accent: #3b6ea5;
      --accent-light: #eaf0f8;
      --text: #2d3748;
      --muted: #718096;
      --border: #d1dbe8;
      --bg: #ffffff;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-size: 10.5pt;
      line-height: 1.7;
      color: var(--text);
      margin: 0;
      padding: 0;
      counter-reset: section-counter;
    }

    /* ── PAGE BREAKS ── */
    .page-break {
      page-break-before: always;
      break-before: page;
    }

    .no-break {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    /* ── COVER PAGE ── */
    .cover-page {
      height: 100vh;
      background: var(--primary);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 60px 70px;
      position: relative;
      overflow: hidden;
    }

    .cover-page::after {
      content: '';
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 8px;
      background: var(--accent);
    }

    .cover-logo-row {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .cover-logo-img {
      width: 60px;
      height: auto;
      background: rgba(255, 255, 255, 0.92);
      padding: 8px;
      border-radius: 8px;
    }

    .cover-logo-name {
      font-size: 15pt;
      font-weight: 700;
      letter-spacing: 1px;
      color: white;
    }

    .cover-tagline {
      font-size: 9pt;
      color: rgba(255, 255, 255, 0.55);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .cover-title {
      font-size: 42pt;
      font-weight: 800;
      line-height: 1.1;
      border-left: 7px solid var(--accent);
      padding-left: 20px;
      margin-bottom: 12px;
    }

    .cover-subtitle {
      font-size: 15pt;
      font-weight: 300;
      opacity: 0.85;
      padding-left: 28px;
    }

    .cover-meta {
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: 24px;
    }

    .cover-meta table {
      border: none;
      margin: 0;
      width: auto;
    }

    .cover-meta td {
      border: none;
      padding: 5px 40px 5px 0;
      color: rgba(255, 255, 255, 0.85);
      font-size: 10.5pt;
    }

    .cover-meta td:first-child {
      font-weight: 600;
      color: rgba(255, 255, 255, 0.55);
      text-transform: uppercase;
      font-size: 8.5pt;
      letter-spacing: 0.8px;
    }

    /* ── SECTION CONTAINER ── */
    .section {
      padding: 36px 0 28px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 4px;
    }

    .section:last-of-type {
      border-bottom: none;
    }

    /* ── SECTION TITLE ── */
    .section-title {
      font-size: 19pt;
      font-weight: 700;
      color: var(--primary);
      margin: 0 0 6px;
      display: flex;
      align-items: baseline;
      gap: 10px;
      counter-increment: section-counter;
    }

    .section-title::before {
      content: counter(section-counter) ".";
      font-size: 14pt;
      font-weight: 400;
      color: var(--accent);
      min-width: 28px;
    }

    .section-rule {
      height: 2px;
      background: var(--border);
      margin-bottom: 22px;
      border: none;
    }

    /* ── CONTENT TYPOGRAPHY ── */
    .content h1,
    .content h2,
    .content h3 {
      color: var(--primary);
      margin-top: 20px;
      margin-bottom: 8px;
    }

    .content h1 {
      font-size: 14pt;
      font-weight: 700;
      border-bottom: 1px solid var(--border);
      padding-bottom: 4px;
    }

    .content h2 {
      font-size: 12pt;
      font-weight: 600;
    }

    .content h3 {
      font-size: 11pt;
      font-weight: 600;
      color: var(--accent);
    }

    .content p {
      margin: 0 0 10px;
      text-align: justify;
    }

    .content strong {
      color: var(--primary);
    }

    .content ul {
      margin: 6px 0 14px 0;
      padding-left: 22px;
    }

    .content ul li {
      margin-bottom: 5px;
      line-height: 1.6;
    }

    .content ul li::marker {
      color: var(--accent);
    }

    .content ol {
      margin: 6px 0 14px 0;
      padding-left: 22px;
    }

    /* Key-Value pairs */
    .content div[style] {
      font-size: 10.5pt;
      line-height: 1.6;
    }

    /* ── COST TABLE ── */
    .cost-table {
      width: 100%;
      border-collapse: collapse;
      margin: 10px 0 0;
      font-size: 10pt;
    }

    .cost-table th {
      background: var(--primary);
      color: white;
      padding: 10px 14px;
      text-align: left;
      font-size: 8.5pt;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      font-weight: 600;
    }

    .cost-table td {
      border: 1px solid var(--border);
      padding: 9px 14px;
      text-align: left;
    }

    .cost-table tr:nth-child(even) {
      background: #f7fafc;
    }

    .cost-table .right {
      text-align: right;
    }

    .cost-total-row td {
      background: var(--accent-light) !important;
      font-weight: 700;
      font-size: 11pt;
      color: var(--primary);
      border-top: 2px solid var(--accent);
    }

    /* ── SIGN-OFF TABLE ── */
    .signoff-table {
      width: 100%;
      border: none;
      margin-top: 60px;
    }

    .signoff-table td {
      border: none;
      vertical-align: top;
      width: 50%;
      padding: 0 30px 0 0;
    }

    .signoff-block {
      padding: 20px 0 0;
    }

    .signoff-line {
      border-top: 1px solid #888;
      margin-top: 60px;
      width: 100%;
    }

    .signoff-label {
      font-size: 9pt;
      color: var(--muted);
      margin-top: 6px;
    }

    /* ── MAIN BODY WRAPPER ── */
    .body-content {
      padding: 0 50px;
    }
  </style>
</head>

<body>

  <!-- ░░ COVER PAGE ░░ -->
  <div class="cover-page">
    <div class="cover-logo-row">
      <img class="cover-logo-img"
        src="data:image/svg+xml;base64,"
        alt="ArgosMob Logo" />
      <div>
        <div class="cover-logo-name">ArgosMob</div>
        <div class="cover-tagline">Tech &amp; AI</div>
      </div>
    </div>

    <div>
      <div class="cover-title">Formal<br />Proposal</div>
      <div class="cover-subtitle">Prepared for {{client_name}}</div>
    </div>

    <div class="cover-meta">
      <table>
        <tr>
          <td>Project</td>
          <td>{{project_name}}</td>
        </tr>
        <tr>
          <td>Date</td>
          <td>{{current_date}}</td>
        </tr>
        <tr>
          <td>Prepared By</td>
          <td>ArgosMob Tech &amp; AI</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ░░ BODY CONTENT ░░ -->
  <div class="body-content page-break">

    {{#if intro}}
    <div class="section no-break">
      <h2 class="section-title">Introduction</h2>
      <hr class="section-rule" />
      <div class="content">{{{intro}}}</div>
    </div>
    {{/if}}

    {{#each sections}}
    {{#if enabled}}
    <div class="section no-break">
      <h2 class="section-title">{{name}}</h2>
      <hr class="section-rule" />
      <div class="content">
        {{{content}}}
      </div>
    </div>
    {{/if}}
    {{/each}}

    {{#if features}}
    <div class="section">
      <h2 class="section-title">Features &amp; Functionalities</h2>
      <hr class="section-rule" />
      <div class="content">{{{features}}}</div>
    </div>
    {{/if}}

    {{#if techStack}}
    <div class="section no-break">
      <h2 class="section-title">Tech Stack</h2>
      <hr class="section-rule" />
      <div class="content">{{{techStack}}}</div>
    </div>
    {{/if}}

    {{#if deliverables}}
    <div class="section no-break">
      <h2 class="section-title">Deliverables</h2>
      <hr class="section-rule" />
      <div class="content">{{{deliverables}}}</div>
    </div>
    {{/if}}

    {{#if timeline}}
    <div class="section no-break">
      <h2 class="section-title">Timeline</h2>
      <hr class="section-rule" />
      <div class="content">{{{timeline}}}</div>
    </div>
    {{/if}}

    {{#if cost_table.length}}
    <div class="section page-break">
      <h2 class="section-title">Cost Estimation</h2>
      <hr class="section-rule" />
      <table class="cost-table">
        <thead>
          <tr>
            <th>Description</th>
            <th class="right" width="8%">Qty</th>
            <th class="right" width="18%">Unit Price</th>
            <th class="right" width="18%">Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each cost_table}}
          <tr>
            <td>{{description}}</td>
            <td class="right">{{quantity}}</td>
            <td class="right">₹{{unitPrice}}</td>
            <td class="right">₹{{total}}</td>
          </tr>
          {{/each}}
          <tr class="cost-total-row">
            <td colspan="3" class="right">Grand Total</td>
            <td class="right">₹{{grand_total}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if changeRequest}}
    <div class="section no-break">
      <h2 class="section-title">Change Request Management</h2>
      <hr class="section-rule" />
      <div class="content">{{{changeRequest}}}</div>
    </div>
    {{/if}}

    <!-- Sign-Off -->
    <div class="section page-break">
      <h2 class="section-title">Acceptance &amp; Sign-Off</h2>
      <hr class="section-rule" />
      <div class="content">
        <p>By signing below, both parties agree to the scope, deliverables, timelines, and costs outlined in this
          proposal.</p>
        <table class="signoff-table">
          <tr>
            <td>
              <div class="signoff-block">
                <strong>For {{client_name}}</strong>
                <div class="signoff-line"></div>
                <div class="signoff-label">Authorised Signatory &nbsp;|&nbsp; Date: ___________</div>
              </div>
            </td>
            <td>
              <div class="signoff-block">
                <strong>For ArgosMob Tech &amp; AI</strong>
                <div class="signoff-line"></div>
                <div class="signoff-label">Authorised Signatory &nbsp;|&nbsp; Date: ___________</div>
              </div>
            </td>
          </tr>
        </table>
      </div>
    </div>

  </div><!-- end body-content -->

</body>

</html>